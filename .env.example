# Sao chép file này thành .env (không commit .env lên Git) và chỉnh URL cho đúng môi trường.

# Khi phát triển cục bộ với XAMPP: URL Apache trỏ tới thư mục api/ của dự án
VITE_API_URL=http://localhost/api

# Khi triển khai thật lên Hostinger (hotrandinh.com), đổi thành:
# VITE_API_URL=https://hotrandinh.com/api
