# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Uploaded user content (created at runtime by server.js)
public/storage/*
!public/storage/.gitkeep

# PHP backend: real credentials and uploaded files never go into Git
api/config.php
api/storage/*
!api/storage/.gitkeep

# Env files
.env
.env.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.local

# Claude Code local settings (per-machine)
.claude/settings.local.json
